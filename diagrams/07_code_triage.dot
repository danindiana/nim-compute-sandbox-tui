 edge [color="#8b949e", fontname="Helvetica", fontcolor="#adbac7", penwidth=1.6, arrowsize=0.9]; rankdir=LR; label="nim check / run results for Hermes's Nim files";
 root [label="safetybox Nim sources"];
 f [label="FAIL to compile (moved to _broken/)", color="#f85149"];
 f1 [label="mcp_server: field named 'method'"]; f2 [label="python_sandbox: syntax error"]; f3 [label="sandbox: bad import path"]; f4 [label="tool_registry: Python-isms Json/dict"]; f5 [label="ui/console: imports 'ratatui' (Rust lib)"]; f6 [label="ui/main_tui: syntax error"];
